# ─────────────────────────────────────────────────────────────
# Urbanizadora y Desarrolladora California — .env.example
# Copiar a .env.local y completar. NO poner valores reales aquí.
# Ver docs/ENVIRONMENT_VARIABLES.md
# ─────────────────────────────────────────────────────────────

# ── Sitio ──
NEXT_PUBLIC_SITE_URL="https://www.desarrolladoracalifornia.com"

# ── Supabase (público) ──
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── Supabase (privado, solo servidor) ──
SUPABASE_SERVICE_ROLE_KEY=""
# CLI / migraciones
SUPABASE_ACCESS_TOKEN=""
SUPABASE_PROJECT_REF=""
SUPABASE_DB_PASSWORD=""

# ── WhatsApp ──
# Solo dígitos, formato E.164 (ej. 526461234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_WHATSAPP_MSG_GENERAL="Hola, me gustaría recibir información."
NEXT_PUBLIC_WHATSAPP_MSG_LANDOWNER="Hola, tengo un terreno y me gustaría una evaluación."
NEXT_PUBLIC_WHATSAPP_MSG_MIRADOR="Hola, me interesa el proyecto Mirador del Valle."

# ── Contacto ──
NEXT_PUBLIC_CONTACT_EMAIL=""
LEADS_NOTIFICATION_EMAIL=""

# ── Email (Resend, opcional) ──
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_FROM_NAME="Urbanizadora y Desarrolladora California"

# ── Mapas (opcional) ──
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ── Analytics / verificación (opcional) ──
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
GOOGLE_SITE_VERIFICATION=""

# ── Admin ──
# Emails autorizados para /admin, separados por coma
ADMIN_ALLOWED_EMAILS=""

# ── Vercel (deploy CLI, opcional) ──
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""
